# Server
PORT=4000
NODE_ENV=development

# Database (MySQL)
# Prisma 오류 "credentials for root are not valid" → PC에 설치된 MySQL 비밀번호/DB명과
# 이 URL이 일치하는지 확인하거나, docker-compose.yml 로 DB를 띄운 뒤 동일 값 사용.
DATABASE_URL="mysql://root:password@localhost:3306/devglobe"

# JWT Secrets (강력한 랜덤 문자열 사용 - openssl rand -base64 64)
JWT_ACCESS_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# GitHub OAuth App (https://github.com/settings/developers 에서 생성)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Frontend URL (CORS + OAuth 리다이렉트용)
FRONTEND_URL=http://localhost:3000

# Cookie 설정
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# 일일 기여 코인(스트릭 동기화 시 UTC 당일 기여 있으면 1회). 미설정 시 1
# DAILY_COIN_AMOUNT=5

# 임시: 동기화 후 코인 = max(기존, 현재스트릭×배수). 예: 스트릭2·배수5 → 최소 10코인. 운영 전 제거
# TEMP_STREAK_COINS_MULTIPLIER=5
